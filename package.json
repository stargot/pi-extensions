{
	"name": "pi-extensions",
	"version": "0.3.0",
	"private": true,
	"license": "MIT",
	"description": "Personal pi package: extensions for the pi coding agent",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"test": "node --test extensions/**/test/*.test.ts",
		"coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"extensions/**/test/**\" --test-coverage-exclude=\"node_modules/**\" extensions/**/test/*.test.ts",
		"smoke": "node scripts/smoke.mjs",
		"stats": "node extensions/session-ledger/cli.ts",
		"recall": "node extensions/session-recall/cli.ts",
		"trace": "node extensions/session-trace/cli.ts",
		"trace:list": "node extensions/session-trace/cli.ts --list",
		"trace:web": "node extensions/session-trace/web/serve.ts",
		"lint": "biome lint extensions scripts",
		"format": "biome format --write extensions scripts",
		"format-check": "biome format extensions scripts",
		"type": "tsc --noEmit",
		"typecheck": "npm run type",
		"check": "npm run lint && npm run format-check && npm run type && npm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"pi": {
		"extensions": [
			"./extensions/ask-user-question/index.ts",
			"./extensions/context-inspector/index.ts",
			"./extensions/edit-guard/index.ts",
			"./extensions/prompt-snippets/index.ts",
			"./extensions/session-handoff/index.ts",
			"./extensions/session-ledger/index.ts",
			"./extensions/session-recall/index.ts",
			"./extensions/session-trace/index.ts",
			"./extensions/subagents/index.ts",
			"./extensions/web/index.ts"
		]
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"linkedom": "^0.18.13",
		"turndown": "^7.2.4",
		"unpdf": "^1.8.1",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/turndown": "^5.0.6",
		"@types/ws": "^8.18.1",
		"typescript": "^7.0.2"
	}
}
